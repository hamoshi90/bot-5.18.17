# انسخ هذا الملف باسم .env وعدّل القيم

# ====== أساسيات (إلزامية) ======
TELEGRAM_BOT_TOKEN=123456789:AA_your_bot_token_here
ADMIN_USER_ID=123456789
DB_PATH=bot.db

# ====== التشفير [NEW 20] ======
# اختياري: مفتاح Fernet لتشفير كلمات المرور.
# إن تركته فارغاً سيولّد البوت ملف secret.key تلقائياً.
# توليد مفتاح: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PASSWORD_ENCRYPTION_KEY=

# ====== Web API [NEW 14/15] ======
# مفتاح لعمليات الكتابة عبر الـ API وصفحة Mini App.
# ولّد مفتاحاً قوياً: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ====== بوابة الدفع [NEW 35] ======
# مفتاح توقيع الويب هوك (HMAC-SHA256). ولّد مفتاحاً قوياً:
# python -c "import secrets; print(secrets.token_hex(32))"
# بدون هذا المفتاح: نقطة الويب هوك معطلة تماماً (401)
PAYMENT_WEBHOOK_SECRET=

# إن نشرت البوت على Render/سحابة ورفضت اللوحة أو شام كاش الاتصال،
# أو لكل خدمة على حدة (تتجاوز العام):

# ====== بروكسي صادر [PROXY-OUT] — للاستضافة السحابية المحجوبة ======
# صيغة: http://user:pass@host:port أو socks5://user:pass@host:port
# OUTBOUND_PROXY=           # عام: للوحة وشام كاش معاً
# BETS55_PROXY=             # للوحة فقط (يتجاوز العام)
# SHAM_PROXY=               # لشام كاش فقط (يتجاوز العام)
